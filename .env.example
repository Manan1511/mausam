# Leave in preview mode until a Shopify store and app are ready.
SHOPIFY_MODE=preview
SHOPIFY_API_VERSION=2026-07

# Shopify store host only, for example example.myshopify.com
SHOPIFY_SHOP_DOMAIN=
# Public HTTPS origin of this app, without a trailing path. Must match Shopify's OAuth redirect allowlist.
SHOPIFY_APP_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ADMIN_EMAIL_ALLOWLIST=
SHOPIFY_ADMIN_SCOPES=read_products,write_metaobjects,write_files
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_CHECKOUT_ALLOWED_HOSTS=
VITE_SHOPIFY_MODE=preview
