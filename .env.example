# Leave in preview mode until a Shopify store and app are ready.
SHOPIFY_MODE=preview
SHOPIFY_API_VERSION=2026-07

# Shopify store host only, for example example.myshopify.com
SHOPIFY_SHOP_DOMAIN=
# Public HTTPS origin of this app, without a trailing path. Must match Shopify's OAuth redirect allowlist.
SHOPIFY_APP_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated verified Shopify staff emails; blank means no admin access.
SHOPIFY_ADMIN_EMAIL_ALLOWLIST=
SHOPIFY_ADMIN_SCOPES=read_products,write_metaobjects,write_files
# Private Headless-channel token; server-side only, never prefix with VITE_. Also used to validate featured-product visibility.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Optional extra Shopify checkout hostnames; shopDomain is allowed automatically.
SHOPIFY_CHECKOUT_ALLOWED_HOSTS=
# Public build selector; set to the same mode as SHOPIFY_MODE for live deploys.
VITE_SHOPIFY_MODE=preview
